table 🧮Measures
	lineageTag: 8f2e119b-a465-4bbd-a19d-1306fa4ff9d9

	measure 'DIVIDE Price MDAX' = ```
			
			    IFERROR(
			        SUM(Sales[NS in €]) / SUM(Sales[QTY]),
			        "No NS!") 
			```
		lineageTag: afe6773a-5dd5-40df-9459-6958e6342f8c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SVG DIVIDE Price MDAX' =
			
			VAR T =
			    ADDCOLUMNS(
			        VALUES(Product[PL4]),
			        "Amount",
			        [DIVIDE Price MDAX]
			    )
			
			VAR MaxAmount =
			    MAXX(T,[Amount])
			
			VAR ChartHeight = 180
			VAR ChartWidth = 600
			
			VAR BarWidth = 80
			VAR Gap = 35
			
			
			VAR Bars =
			    CONCATENATEX(
			        T,
			
			        VAR Cat =
			            Product[PL4]
			
			        VAR Val =
			            [Amount]
			
			        VAR BarH =
			            DIVIDE(
			                Val,
			                MaxAmount
			            ) * ChartHeight
			
			        VAR Index =
			            RANKX(
			                T,
			                Product[PL4],
			                ,
			                ASC
			            ) - 1
			
			        VAR X =
			            80 + Index * (BarWidth + Gap)
			
			        VAR Y =
			            ChartHeight - BarH + 25
			
			
			        RETURN
			
			        "<rect x=""" & X &
			        """ y=""" & Y &
			        """ width=""" & BarWidth &
			        """ height=""" & BarH &
			        """ rx=""8""
			        fill=""%23BFC3A3""/>"
			
			
			        &
			
			
			        "<text x=""" & X + BarWidth / 2 &
			        """ y=""" & Y - 12 &
			        """ text-anchor=""middle""
			        font-family=""Calibri""
			        font-size=""16""
			        fill=""%23333333"">"
			        &
			        FORMAT(
			            Val,
			            "#,##0.00"
			        )
			        &
			        "</text>"
			
			
			        &
			
			
			        "<text x=""" & X + BarWidth / 2 &
			        """ y=""245""
			        text-anchor=""middle""
			        font-family=""Calibri""
			        font-size=""22""
			        fill=""%23333333"">"
			        &
			        Cat
			        &
			        "</text>",
			
			        ""
			    )
			
			
			VAR AxisLabels =
			
			"<text x=""55"" y=""25""
			text-anchor=""end""
			font-family=""Calibri""
			font-size=""16""
			fill=""%23333333"">"
			&
			FORMAT(
			    MaxAmount,
			    "#,##0.00"
			)
			&
			"</text>"
			
			
			&
			
			
			"<text x=""55"" y=""110""
			text-anchor=""end""
			font-family=""Calibri""
			font-size=""16""
			fill=""%23333333"">"
			&
			FORMAT(
			    MaxAmount / 2,
			    "#,##0.00"
			)
			&
			"</text>"
			
			
			&
			
			
			"<text x=""55"" y=""205""
			text-anchor=""end""
			font-family=""Calibri""
			font-size=""16""
			fill=""%23333333"">
			0.00
			</text>"
			
			
			VAR SVG =
			
			"<svg xmlns=""http://www.w3.org/2000/svg""
			width=""" & ChartWidth & """
			height=""280"">"
			
			&
			
			AxisLabels
			
			&
			
			Bars
			
			&
			
			"<text x=""10""
			y=""270""
			text-anchor=""start""
			font-family=""Calibri""
			font-size=""16""
			font-weight=""bold""
			fill=""%23333333"">
			Price
			</text>"
			
			&
			
			"</svg>"
			
			
			RETURN
			
			"data:image/svg+xml;utf8," & SVG
		lineageTag: 3b3938ad-27b4-46ac-bb58-aa9751b07ef8
		dataCategory: ImageUrl

