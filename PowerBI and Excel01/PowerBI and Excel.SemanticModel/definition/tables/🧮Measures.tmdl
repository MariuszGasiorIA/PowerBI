	measure 'LOGIC Product volume type MDAX' =
			
			--VAR ProductName = SELECTEDVALUE(Product[Product name])
			VAR ProductName = MAX(Product[Product name])
			
			VAR StartPos =
			    MINX(
			        FILTER(
			            GENERATESERIES(1, LEN(ProductName)),
			            MID(ProductName, [Value], 1) >= "0"
			                && MID(ProductName, [Value], 1) <= "9"
			        ),
			        [Value]
			    )
			
			VAR SizeText =
			    MID(ProductName, StartPos, LEN(ProductName))
			
			VAR SizeML =
			    IF(
			        CONTAINSSTRING(SizeText, "ml"),
			        VALUE(SUBSTITUTE(SizeText, "ml", "")),
			        VALUE(SUBSTITUTE(SizeText, "L", "")) * 1000
			    )
			
			RETURN
			    IF(
			        SizeML < 500,
			        "Lower than 500ml",
			        IF(
			            SizeML = 500,
			            "Equal 500ml",
			            "Bigger than 500ml"
			        )
			    )
		lineageTag: e5cf1a68-ddf5-411f-867d-a5c66a386ce4

	measure 'LOGIC Sugar content classification DAX' = ```
			
			    SWITCH(
			        SELECTEDVALUE('Product'[PL4]),
			            "Clear","No",
			            "Juice","Medium",
			            "Sugary","High",
			            "Invalid data"
			            --BLANK() // we can also add blank 
			    )
			```
		lineageTag: 3e341be8-7db1-480e-af24-f6dbda3c666e

	measure 'LOGIC Sugar cubes DAX' = ```
			
			    SWITCH(
			        SELECTEDVALUE(Product[PL4]),
			        "Clear", "🚫",
			        "Juice", "🧊🧊",
			        "Sugary", "🧊🧊🧊🧊🧊",
			        BLANK()
			    )
			```
		lineageTag: fcd6295d-ea69-49a6-aec2-cdd8eeb2ee6f

