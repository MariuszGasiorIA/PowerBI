			&
			
			
			"<text x=""55"" y=""205""
			text-anchor=""end""
			font-family=""Calibri""
			font-size=""16""
			fill=""%23333333"">
			0.00
			</text>"
			
			
			VAR SVG =
			
			"<svg xmlns=""http://www.w3.org/2000/svg""
			width=""" & ChartWidth & """
			height=""280"">"
			
			&
			
			AxisLabels
			
			&
			
			Bars
			
			&
			
			"<text x=""10""
			y=""270""
			text-anchor=""start""
			font-family=""Calibri""
			font-size=""16""
			font-weight=""bold""
			fill=""%23333333"">
			NS in € [M]
			</text>"
			
			&
			
			"</svg>"
			
			
			RETURN
			
			"data:image/svg+xml;utf8," & SVG
