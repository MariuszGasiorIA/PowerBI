	measure 'SVG DIVIDE NS MDAX' =
			
			VAR T =
			    ADDCOLUMNS(
			        VALUES(Product[PL4]),
			        "Amount",
			        [SUM NS in € MDAX]
			    )
			
			VAR MaxAmount =
			    MAXX(T,[Amount])
			
			VAR ChartHeight = 180
			VAR ChartWidth = 600
			
			VAR BarWidth = 80
			VAR Gap = 35
			
			
			VAR Bars =
			    CONCATENATEX(
			        T,
			
			        VAR Cat =
			            Product[PL4]
			
			        VAR Val =
			            [Amount]
			
			        VAR BarH =
			            DIVIDE(
			                Val,
			                MaxAmount
			            ) * ChartHeight
			
			        VAR Index =
			            RANKX(
			                T,
			                Product[PL4],
			                ,
			                ASC
			            ) - 1
			
			        VAR X =
			            80 + Index * (BarWidth + Gap)
			
			        VAR Y =
			            ChartHeight - BarH + 25
			
			
			        RETURN
			
			        "<rect x=""" & X &
			        """ y=""" & Y &
			        """ width=""" & BarWidth &
			        """ height=""" & BarH &
			        """ rx=""8""
			        fill=""%23BFC3A3""/>"
			
			
			        &
			
			
			        "<text x=""" & X + BarWidth / 2 &
			        """ y=""" & Y - 12 &
			        """ text-anchor=""middle""
			        font-family=""Calibri""
			        font-size=""16""
			        fill=""%23333333"">"
			        &
			        FORMAT(
			            Val,
			            "# ##0"
			        )
			        &
			        "</text>"
			
			
			        &
			
			
			        "<text x=""" & X + BarWidth / 2 &
			        """ y=""245""
			        text-anchor=""middle""
			        font-family=""Calibri""
			        font-size=""22""
			        fill=""%23333333"">"
			        &
			        Cat
			        &
			        "</text>",
			
			        ""
			    )
			
			
			VAR AxisLabels =
			
			"<text x=""55"" y=""25""
			text-anchor=""end""
			font-family=""Calibri""
			font-size=""16""
			fill=""%23333333"">"
			&
			FORMAT(
			    MaxAmount,
			    "# ##0"
			)
			&
			"</text>"
			
			
			&
			
			
			"<text x=""55"" y=""110""
