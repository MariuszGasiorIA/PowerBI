			            l <= 6, LEFT(t, l-3) & " " & RIGHT(t,3),
			            l <= 9, LEFT(t, l-6) & " " & MID(t, l-5, 3) & " " & RIGHT(t,3),
			            LEFT(t, l-9) & " " & MID(t, l-8, 3) & " " & MID(t, l-5, 3) & " " & RIGHT(t,3)
			        )
			
			VAR _SVG =
			"
			<svg xmlns='http://www.w3.org/2000/svg' width='180' height='50' viewBox='0 0 180 50'>
			    <rect x='1' y='1' width='178' height='48' rx='12' ry='12'
			        fill='" & _BgColor & "' stroke='" & _Color & "' stroke-width='2'/>
			
			    <text x='90' y='32'
			        font-family='Segoe UI'
			        font-size='20'
			        font-weight='600'
			        fill='" & _Color & "'
			        text-anchor='middle'>
			        " & _Arrow & " " & _Clean & " YoY" & "
			    </text>
			</svg>
			"
			
			RETURN
			    "data:image/svg+xml;utf8," & _SVG
		lineageTag: 54081564-be4a-46db-9f6e-4e8601035f26

	measure 'DIVIDE Qty ''24 vs''25' = ```
			
			
			VAR Qty24 = 
			    CALCULATE(
			        [SUM Quantity MGDAX],
			        'Date'[Year] = 2024)
			
			VAR Qty25 = 
			    CALCULATE(
			        [SUM Quantity MGDAX],
			        'Date'[Year] = 2025)
			
			RETURN
			    DIVIDE(
			         Qty25- Qty24,
			         Qty24,
			         0)
			```
		lineageTag: c9f5764f-5d14-45cc-bd31-ffcf9ff82e0f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SVG KPI Qty %' =
			
			VAR _Value = [DIVIDE Qty '24 vs'25]
			
			VAR _Color =
			    IF(
			        _Value >= 0,
			        "#2E7D32",      -- zielony
			        "#E91E63"       -- różowy
			    )
			
			VAR _FillColor =
			    IF(
			        _Value >= 0,
			        "#E8F5E9",      -- jasnozielone tło
			        "#FCE4EC"       -- jasnoróżowe tło
			    )
			
			VAR _Arrow =
			    IF(
			        _Value >= 0,
			        "▲",
			        "▼"
			    )
			
			VAR _Text =
			    FORMAT(_Value, "+0%;-0%;0%")
			
			VAR _SVG =
			"
			<svg xmlns='http://www.w3.org/2000/svg' width='180' height='50' viewBox='0 0 180 50'>
			    <rect
			        x='1'
			        y='1'
			        width='178'
			        height='48'
			        rx='12'
			        ry='12'
			        fill='" & _FillColor & "'
			        stroke='" & _Color & "'
			        stroke-width='2'/>
			
			    <text
			        x='90'
			        y='32'
			        font-family='Segoe UI'
			        font-size='20'
			        font-weight='600'
			        fill='" & _Color & "'
			        text-anchor='middle'>
			        " & _Arrow & " " & _Text & " YoY" &"
			    </text>
			</svg>
			"
			
			RETURN
			"data:image/svg+xml;utf8," & _SVG
		lineageTag: 9d3f6e22-0c7a-45d7-b216-e59338352eda

