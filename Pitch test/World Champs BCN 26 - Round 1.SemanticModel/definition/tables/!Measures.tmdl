	measure 'SVG Bar Chart NetRevenue MGDAX' =
			
			VAR Years =
			    VALUES ( 'Date'[Year] )
			
			VAR MaxValue =
			    MAXX (
			        Years,
			        CALCULATE ( [SUM NetRevenue MGDAX] )
			    )
			
			VAR BarWidth = 90
			VAR Gap = 24
			VAR BaseY = 300
			
			VAR CountYears =
			    COUNTROWS ( Years )
			
			VAR ChartWidth =
			    CountYears * BarWidth + ( CountYears - 1 ) * Gap
			
			VAR svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='"
			    & ChartWidth &
			    "' height='300' viewBox='0 0 "
			    & ChartWidth &
			    " 300'>"
			    &
			    CONCATENATEX (
			        Years,
			        VAR v =
			            CALCULATE ( [SUM NetRevenue MGDAX] )
			
			        VAR idx =
			            RANKX ( Years, 'Date'[Year], , ASC )
			
			        VAR h =
			            DIVIDE ( v, MaxValue ) * 300
			
			        VAR x =
			            ( idx - 1 ) * ( BarWidth + Gap )
			
			        VAR y =
			            BaseY - h
			
			        VAR color =
			            IF ( v = MaxValue, "#555555", "#B0B0B0" )
			
			        VAR rx =
			            BarWidth / 2
			
			        RETURN
			            "<rect x='"
			            & x &
			            "' y='"
			            & y &
			            "' width='"
			            & BarWidth &
			            "' height='"
			            & h &
			            "' rx='"
			            & rx &
			            "' fill='"
			            & color &
			            "' />",
			        "",
			        'Date'[Year],
			        ASC
			    )
			    &
			    "</svg>"
			
			RETURN
			    "data:image/svg+xml;utf8," & svg
		lineageTag: b44ed4d8-1b13-4097-adb2-f11041e57250
		dataCategory: ImageUrl

	measure 'SVG KPI NetRevenue %' =
			
			VAR _Value = [DIVIDE NR '24 vs'25]
			
			VAR _Color =
			    IF(
			        _Value >= 0,
			        "#2E7D32",      -- zielony
			        "#E91E63"       -- różowy
			    )
			
			VAR _FillColor =
			    IF(
			        _Value >= 0,
			        "#E8F5E9",      -- jasnozielone tło
			        "#FCE4EC"       -- jasnoróżowe tło
			    )
			
			VAR _Arrow =
			    IF(
			        _Value >= 0,
			        "▲",
			        "▼"
			    )
			
			VAR _Text =
			    FORMAT(_Value, "+0%;-0%;0%")
			
			VAR _SVG =
			"
			<svg xmlns='http://www.w3.org/2000/svg' width='180' height='50' viewBox='0 0 180 50'>
			    <rect
			        x='1'
			        y='1'
			        width='178'
			        height='48'
			        rx='12'
			        ry='12'
			        fill='" & _FillColor & "'
			        stroke='" & _Color & "'
			        stroke-width='2'/>
			
			    <text
			        x='90'
			        y='32'
			        font-family='Segoe UI'
			        font-size='20'
			        font-weight='600'
			        fill='" & _Color & "'
			        text-anchor='middle'>
			        " & _Arrow & " " & _Text & " YoY" &"
			    </text>
			</svg>
			"
			
			RETURN
			"data:image/svg+xml;utf8," & _SVG
		lineageTag: 5a8b7b18-dd87-41cc-9b13-7e31f021c17d

	measure 'Diff Net Revenue%' =
			
			0.5
		lineageTag: c0483a8f-376b-40d3-a3ae-9028168d26e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SVG KPI NetRevenue Absolute' =
			
			VAR _Value = [DIFF NR '24 vs'25]
			
			VAR _Color =
			    IF(_Value >= 0, "#2E7D32", "#E91E63")
			
			VAR _BgColor =
			    IF(_Value >= 0, "#E8F5E9", "#FCE4EC")
			
			VAR _Arrow =
			    IF(_Value >= 0, "▲", "▼")
			
			VAR _Num =
			    INT(ABS(_Value))
			
			VAR _Text =
			    FORMAT(_Num, "0")
			
			-- ręczne dodanie separatora tysięcy (spacja)
			VAR _Len = LEN(_Text)
			
			VAR _Grouped =
			    CONCATENATEX(
			        GENERATESERIES(1, _Len),
			        MID(_Text, _Len - [Value] + 1, 1),
			        "",
			        [Value],
			        DESC
			    )
			
			VAR _Chunks =
			    CONCATENATEX(
			        GENERATESERIES(1, _Len),
			        MID(_Text, _Len - [Value] + 1, 1),
			        "",
			        [Value],
			        DESC
			    )
			
			-- właściwe grupowanie
			VAR _Final =
			    CONCATENATEX(
			        ADDCOLUMNS(
			            GENERATESERIES(1, _Len),
			            "Char", MID(_Text, _Len - [Value] + 1, 1)
			        ),
			        [Char],
			        "",
			        [Value],
			        DESC
			    )
			
			-- PROSTE I PEWNE: wstaw spacje ręcznie
			VAR _Clean =
			    VAR t = _Text
			    VAR l = LEN(t)
			    RETURN
			        SWITCH(
			            TRUE(),
			            l <= 3, t,
			            l <= 6, LEFT(t, l-3) & " " & RIGHT(t,3),
			            l <= 9, LEFT(t, l-6) & " " & MID(t, l-5, 3) & " " & RIGHT(t,3),
			            LEFT(t, l-9) & " " & MID(t, l-8, 3) & " " & MID(t, l-5, 3) & " " & RIGHT(t,3)
			        )
			
			VAR _SVG =
			"
			<svg xmlns='http://www.w3.org/2000/svg' width='180' height='50' viewBox='0 0 180 50'>
			    <rect x='1' y='1' width='178' height='48' rx='12' ry='12'
			        fill='" & _BgColor & "' stroke='" & _Color & "' stroke-width='2'/>
			
			    <text x='90' y='32'
			        font-family='Segoe UI'
			        font-size='20'
			        font-weight='600'
			        fill='" & _Color & "'
			        text-anchor='middle'>
			        " & _Arrow & " " & _Clean & " YoY" & "
			    </text>
			</svg>
			"
			
			RETURN
			    "data:image/svg+xml;utf8," & _SVG
		lineageTag: 96f2ecc7-6fee-4620-aff5-fa1e8c97e5c5

