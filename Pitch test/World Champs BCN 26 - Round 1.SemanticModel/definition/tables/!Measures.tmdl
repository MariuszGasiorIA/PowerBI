		lineageTag: d8afab90-9ea6-4168-9369-10b432fbdcd2

	measure 'DIVIDE NetRevenue DBD' =
			
			
			VAR _Current =
			    [SUM NetRevenue MGDAX]
			
			VAR _Previous_Month =
			    CALCULATE(
			        [SUM NetRevenue MGDAX],
			        DATEADD('Date'[Date], -1, MONTH)
			    )
			
			VAR _Previous_Year =
			    CALCULATE(
			        [SUM NetRevenue MGDAX],
			        DATEADD('Date'[Date], -1, YEAR)
			    )
			
			-- wykrycie poziomu
			VAR _IsMonth =
			    NOT ISBLANK(SELECTEDVALUE('Date'[MonthName]))
			
			VAR _IsYear =
			    NOT ISBLANK(SELECTEDVALUE('Date'[Year]))
			
			VAR _Previous =
			    SWITCH(
			        TRUE(),
			        _IsMonth, _Previous_Month,
			        _IsYear, _Previous_Year,
			        BLANK()
			    )
			
			RETURN
			    DIVIDE(_Current - _Previous, _Previous)
		formatString: 0%;-0%;0%
		lineageTag: 39b1a8b7-4f23-43b4-8ed2-ac8b7a5ebdc1

	measure 'DIVIDE NR ''24 vs''25' = ```
			
			
