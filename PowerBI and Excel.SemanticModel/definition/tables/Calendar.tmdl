	column 'Year and Month'
		lineageTag: e5006e32-0ca2-4d48-84a5-9e25cd0fd19f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year and Month]

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source = ```
				
				VAR __StartDate = DATE(2023, 01, 01)
				VAR __EndDate = DATE(2026, 12, 31)
				VAR CurrentQuarter = QUARTER(TODAY())
				VAR CurrentYear = YEAR(TODAY())
				VAR XNextYear = CurrentYear + 1
				
				RETURN
				ADDCOLUMNS(
				    CALENDAR(__StartDate, __EndDate),
				    "Year", YEAR([Date]),
				    "Quarter", "Q" & QUARTER([Date]),
				    "Month", MONTH([Date]),
				    "Day", DAY([Date]),
				    "Days in month", DATEDIFF([Date], EOMONTH([Date], 0), DAY) + 1,
				    "Quarter and Year", "Q" & QUARTER([Date]) & " " & YEAR([Date]),
				    "Year and Quarter", YEAR([Date]) & " Q" & QUARTER([Date]),
				    "Year and Month", YEAR([Date]) & " M" & Month([Date]),
				    "Month name", FORMAT([Date], "MMMM", "pl-PL"),
				    "Month short", FORMAT([Date], "MMM", "pl-PL"),
				    "Week number", WEEKNUM([Date]),
				    "Previous year", YEAR([Date]) - 1,
				    "IsCurrentDay", IF([Date] = TODAY(), "Yes", "No"),
				    "IsCurrentMonth", IF(
				        YEAR([Date]) = YEAR(TODAY()) && MONTH([Date]) = MONTH(TODAY()), "Yes", "No"
				    ),
				    "IsPreviousMonth", IF(
				        YEAR([Date]) = YEAR(TODAY()) && MONTH([Date]) = MONTH(TODAY()) - 1, "Yes", "No"
				    ),
				    "Previous date", DATE(YEAR([Date]) - 1, MONTH([Date]), DAY([Date])),
				    "Previous Quarter", IF(
				        YEAR([Date]) = CurrentYear && QUARTER([Date]) = CurrentQuarter - 1, "Yes", "No"
				    ),
				    "IsPreviousMonth2", IF(
				        YEAR([Date]) = YEAR(TODAY()) && MONTH([Date]) = MONTH(TODAY()) - 2, "Yes", "No"
				    ),
				    "Actual Quarter", IF(
				        YEAR([Date]) = CurrentYear && QUARTER([Date]) = CurrentQuarter, "Yes", "No"
				    ),
				    "Next Quarter", IF(
				        YEAR([Date]) = CurrentYear && QUARTER([Date]) = CurrentQuarter + 1, "Yes", "No"
				    ),
				    "IsCurrentYear", IF(YEAR([Date]) = CurrentYear, "Yes", "No"),
				    "IsPreviousYear", IF(YEAR([Date]) = CurrentYear - 1, "Yes", "No"),
				    "IsNextYear", IF(YEAR([Date]) = XNextYear, "Yes", "No"),
				    "Month Number Sequential", (YEAR([Date]) - 2025) * 12 + MONTH([Date])
				)
				
				```

	annotation PBI_Id = 42a9f8eede254a31883763f261c64944

