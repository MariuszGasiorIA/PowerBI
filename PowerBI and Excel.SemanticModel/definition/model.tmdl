model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Value","Product","Sales","Engi","🧮Measures"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table Calendar
ref table Product
ref table Sales
ref table Engi
ref table 🧮Measures

ref cultureInfo en-US

